# Copia este archivo a .env (scripts/setup lo hace por ti) y completa las credenciales.

# LiveKit Cloud: cloud.livekit.io -> Settings -> API Keys
LIVEKIT_URL=wss://<tu-proyecto>.livekit.cloud
LIVEKIT_API_KEY=<tu_api_key>
LIVEKIT_API_SECRET=<tu_api_secret>

# Nombre con el que se registra el agente (debe coincidir con agent_name en src/agent.py)
AGENT_NAME=nexus

# Puerto de Ollama en el host (dentro de Docker siempre es 11434)
OLLAMA_PORT=11435
OLLAMA_MODEL=nexus

# Faster-Whisper: tiny | base | small | medium (medium no cabe junto al resto en GPUs de 4 GB)
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=false

# Opcional: usar un Ollama instalado en Windows/macOS (por ejemplo, modelos *-cloud)
# en lugar del contenedor `ollama`. Requiere Ollama corriendo en el host en el puerto 11434
# y, para modelos cloud, haber ejecutado `ollama signin`.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=gemma4:31b-cloud

# Portal de Conocimiento UAM (WordPress REST). Contraseña de aplicación entregada por la UAM.
# Sin usuario/contraseña, knowledge-sync indexa solo Documentos UAM.
PORTAL_CONOCIMIENTO_URL=https://portalconocimiento.autonoma.edu.co
PORTAL_CONOCIMIENTO_USER=
PORTAL_CONOCIMIENTO_APP_PASSWORD=

# Cada cuántas horas knowledge-sync vuelve a sincronizar (0 = una sola vez al arrancar)
SYNC_INTERVAL_HOURS=24
