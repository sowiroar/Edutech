# Copia este archivo a .env (scripts/setup lo hace por ti) y completa las credenciales.

# LiveKit self-hosted (contenedor "livekit" en docker-compose.yml, modo
# --dev): no hace falta cuenta ni cuota de LiveKit Cloud. devkey/secret son
# las credenciales de desarrollo por defecto de --dev, no secretas.
# LIVEKIT_URL: la usa el navegador -> localhost.
# LIVEKIT_URL_INTERNAL: la usan voice-agent/avatar-bridge dentro de Docker.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_URL_INTERNAL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Nombre con el que se registra el agente (debe coincidir con agent_name en src/agent.py)
AGENT_NAME=nexus

# Google Gemini Live API
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Avatar (NEXO/Familia VIVA, Unreal Engine) vía MJPEG (ver avatar-render/README.md,
# reemplaza al intento anterior con Pixel Streaming, que nunca llegó a verse en el
# navegador). El avatar solo se muestra mientras Unreal esté conectado al puente
# (avatar-bridge). El default ya apunta a avatar-render (que comparte red con
# avatar-bridge): solo hace falta tocar esto si se mueve el stream a otro lado.
AVATAR_STREAM_SOURCE_URL=http://avatar-bridge:8080/stream
# Carpeta Linux/ del paquete de Unreal (ver avatar-render/README.md para generarlo;
# ~2GB, no vive en git). Default: sibling de este repo, mismo layout que Avatar/.
AVATAR_PACKAGE_DIR=../Avatar-Package/Linux
# Con el avatar en vivo se silencia el audio de LiveKit y se usa el de Unreal (labios sincronizados).
# Pon false para mantener el audio de LiveKit (los labios irán un poco desfasados).
AVATAR_MUTE_AGENT_AUDIO=true

# Puerto de Ollama en el host (dentro de Docker siempre es 11434)
OLLAMA_PORT=11435
OLLAMA_MODEL=nexus

# Faster-Whisper: tiny | base | small | medium (medium no cabe junto al resto en GPUs de 4 GB)
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=false

# Opcional: usar un Ollama instalado en Windows/macOS (por ejemplo, modelos *-cloud)
# en lugar del contenedor `ollama`. Requiere Ollama corriendo en el host en el puerto 11434
# y, para modelos cloud, haber ejecutado `ollama signin`.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=gemma4:31b-cloud

# Portal de Conocimiento UAM (WordPress REST). Contraseña de aplicación entregada por la UAM.
# Sin usuario/contraseña, knowledge-sync indexa solo Documentos UAM.
PORTAL_CONOCIMIENTO_URL=https://portalconocimiento.autonoma.edu.co
PORTAL_CONOCIMIENTO_USER=
PORTAL_CONOCIMIENTO_APP_PASSWORD=

# Cada cuántas horas knowledge-sync vuelve a sincronizar (0 = una sola vez al arrancar)
SYNC_INTERVAL_HOURS=24
