# Configuración LOCAL; no reutilizar credenciales del servidor en Git.
GOOGLE_API_KEY=
# Confirmar con Jacobo el ID habilitado que usa en UAM. No asumir que el
# default histórico del código exista o esté disponible para esta cuenta.
GEMINI_LIVE_MODEL=

# Opcional: acceso de lectura al portal. Si faltan usuario/contraseña, el sync
# conserva el recorrido de fuentes públicas. Nunca versionar valores reales.
PORTAL_CONOCIMIENTO_URL=https://portalconocimiento.autonoma.edu.co
PORTAL_CONOCIMIENTO_USER=
PORTAL_CONOCIMIENTO_APP_PASSWORD=
SYNC_INTERVAL_HOURS=24
