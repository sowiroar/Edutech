  "narrative": {
    "northStar": "Continuidad del frontend VIVAVerse",
    "overview": "La superficie operativa hereda Public Sans, los colores semánticos y el cambio claro/oscuro del frontend existente. La jerarquía se construye con tipografía, espacio y divisores; las tablas conservan la relación entre datos, unidades y cobertura. No se establece una identidad visual nueva.",
    "keyCharacteristics": [
      "Tipografía continua con el frontend de voz.",
      "Superficies planas y contraste semántico.",
      "Cifras tabulares y contexto de medición visible.",
      "Controles etiquetados y desplazamiento horizontal local."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Los componentes consumen las variables compartidas para que texto, fondo y estados cambien juntos con el tema.",
        "section": "colors"
      },
      {
        "name": "The Measured Number Rule",
        "body": "Tamaño y alineación ayudan a comparar cifras; la unidad, el denominador y la ausencia de dato permanecen visibles junto a ellas.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do conservar Public Sans y los tokens semánticos compartidos.",
      "Do acompañar cifras con unidades, cobertura y estados de ausencia de dato.",
      "Do mantener foco visible y regiones de tabla accesibles por teclado.",
      "Do mantener la densidad legible mediante desplazamiento de tablas en móvil."
    ],
    "donts": [
      "Don’t convertir las secciones operativas en tarjetas decorativas.",
      "Don’t representar ausencia de medición como cero ni estimación como factura.",
      "Don’t aplicar la composición de /admin al recorrido de voz sin revisar su contexto."
    ]
  }
